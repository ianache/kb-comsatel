KCP_HOST=127.0.0.1
KCP_PORT=8787
KCP_LOG_LEVEL=info
KCP_OTEL_ENABLED=false
KCP_OTEL_ENDPOINT=
KCP_OTEL_SERVICE_NAME=knowledge-context-mcp
KCP_OTEL_ENVIRONMENT=local

# I5-E2 resilience and outbound security
KCP_OPERATION_TIMEOUT_MS=10000
KCP_RATE_LIMIT_CAPACITY=60
KCP_RATE_LIMIT_REFILL_PER_SECOND=1
KCP_MAX_CONCURRENT_REQUESTS=16
KCP_BREAKER_FAILURE_THRESHOLD=3
KCP_BREAKER_OPEN_MS=30000
KCP_BREAKER_HALF_OPEN_MAX_CALLS=1
KCP_EGRESS_ALLOW_HTTP=false
KCP_EGRESS_ALLOW_PRIVATE_NETWORKS=false
KCP_EGRESS_GITLAB_ALLOWED_HOSTS=
KCP_EGRESS_GITLAB_SOURCE_ALLOWED_HOSTS=
KCP_EGRESS_DRIVE_ALLOWED_HOSTS=
KCP_EGRESS_EMBEDDING_ALLOWED_HOSTS=
KCP_EGRESS_QDRANT_ALLOWED_HOSTS=
KCP_EGRESS_OIDC_ALLOWED_HOSTS=

# I5-A GitLab source ingestion (read-only; disabled by default)
KCP_GITLAB_SOURCE_ENABLED=false
KCP_GITLAB_SOURCE_BASE_URL=https://gitlab.example.com
KCP_GITLAB_SOURCE_PROJECT_ID=
KCP_GITLAB_SOURCE_TOKEN=
KCP_GITLAB_SOURCE_REF=main
KCP_GITLAB_SOURCE_ROOT=knowledge
KCP_GITLAB_SOURCE_TIMEOUT_MS=10000

# I5-B remote GitLab indexing also requires I3/MySQL/Qdrant to be enabled.

# I5-C Google Drive source (read-only; disabled by default)
KCP_GOOGLE_DRIVE_SOURCE_ENABLED=false
KCP_GOOGLE_DRIVE_BASE_URL=https://www.googleapis.com/drive/v3
KCP_GOOGLE_DRIVE_FOLDER_IDS=
KCP_GOOGLE_DRIVE_TOKEN=
KCP_GOOGLE_DRIVE_TIMEOUT_MS=10000
