KCP_HOST=127.0.0.1
KCP_PORT=8787
KCP_LOG_LEVEL=info

# I5-A GitLab source ingestion (read-only; disabled by default)
KCP_GITLAB_SOURCE_ENABLED=false
KCP_GITLAB_SOURCE_BASE_URL=https://gitlab.example.com
KCP_GITLAB_SOURCE_PROJECT_ID=
KCP_GITLAB_SOURCE_TOKEN=
KCP_GITLAB_SOURCE_REF=main
KCP_GITLAB_SOURCE_ROOT=knowledge
KCP_GITLAB_SOURCE_TIMEOUT_MS=10000

# I5-B remote GitLab indexing also requires I3/MySQL/Qdrant to be enabled.

# I5-C Google Drive source (read-only; disabled by default)
KCP_GOOGLE_DRIVE_SOURCE_ENABLED=false
KCP_GOOGLE_DRIVE_BASE_URL=https://www.googleapis.com/drive/v3
KCP_GOOGLE_DRIVE_FOLDER_IDS=
KCP_GOOGLE_DRIVE_TOKEN=
KCP_GOOGLE_DRIVE_TIMEOUT_MS=10000
